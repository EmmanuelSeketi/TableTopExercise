# Public URL of the deployed app, used for QR codes and absolute links.
# Set this to your VPS domain, for example https://exercise.example.com.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001

# Docker Compose database credentials. Use a unique, URL-safe password on the VPS.
POSTGRES_DB=tabletop
POSTGRES_USER=tabletop
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password

# Shared API write token. Keep these values identical for local development.
# In Docker Compose, the public value is supplied from EXERCISE_API_SECRET at build time.
# The browser token is visible to app users and is not a substitute for authentication.
NEXT_PUBLIC_EXERCISE_API_SECRET=replace-with-a-long-random-token
EXERCISE_API_SECRET=replace-with-a-long-random-token
