# URL participants and other devices use to reach the app. Set this to your
# computer's LAN IP for local Docker use, or your HTTPS domain on a VPS.
NEXT_PUBLIC_APP_URL=http://192.168.1.100:3001

# Docker Compose database credentials. Use a unique, URL-safe password on the VPS.
POSTGRES_DB=tabletop
POSTGRES_USER=tabletop
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password

# Host-side `npm run dev` connects to the local Docker database through this loopback port.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=tabletop
PGPASSWORD=replace-with-a-long-random-alphanumeric-password
PGDATABASE=tabletop

# Password required to access facilitator and moderator pages.
FACILITATOR_PASSWORD=replace-with-a-long-unique-password
# Used to sign HttpOnly session cookies. Generate a separate random value of at least 32 bytes.
SESSION_SECRET=replace-with-a-long-random-secret
# Keep false for HTTP local-network testing. Set true when the app is served over HTTPS.
AUTH_COOKIE_SECURE=false
# Use 0.0.0.0 for LAN access during local testing. On a VPS behind a reverse proxy, use 127.0.0.1.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=3001
